<template>
    <view>
        <text>native-view：</text>
        <native-view style="width: 100%;height: 40px;" @init="init"></native-view>
    </view>
</template>

<script lang="ts" setup>
    import { ButtonBuilder } from '@/uni_modules/native-button'
    function init(e : UniNativeViewInitEvent) {
        console.log('init', e)
        const el = e.detail.element;
        console.log('ButtonBuilder',ButtonBuilder)
        el.bindHarmonyWrappedBuilder(wrapBuilder(ButtonBuilder), {
            label: 'label'
        })
    }
</script>